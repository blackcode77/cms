# Copy to .env (make init does this automatically)
COMPOSE_PROJECT_NAME=cms
HTTP_PORT=80

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Set to debug,develop to enable Xdebug
XDEBUG_MODE=off

# Initial admin seeded by app:seed; set real values per environment
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# HS256 secret for access tokens (JWT); generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# Outgoing mail (symfony/mailer DSN); dev uses the Mailpit container, UI on http://localhost:${MAILPIT_PORT}
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM=cms@cms.localhost
MAILPIT_PORT=8025
