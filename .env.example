# Copy to .env (make init does this automatically)
COMPOSE_PROJECT_NAME=cms
HTTP_PORT=80

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Set to debug,develop to enable Xdebug
XDEBUG_MODE=off

# Initial admin seeded by app:seed. `make init` generates ADMIN_PASSWORD; app:seed refuses an empty,
# short (< 8) or "change-me..." password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# HS256 secret for access tokens (JWT), at least 32 characters; `make init` generates it
# (manually: `openssl rand -hex 32`). The API refuses to issue tokens with an empty/short/"change-me..." secret.
JWT_SECRET=

# Outgoing mail (symfony/mailer DSN); dev uses the Mailpit container, UI on http://localhost:${MAILPIT_PORT}
MAILER_DSN=smtp://mailpit:1025
MAIL_FROM=cms@cms.localhost
MAILPIT_PORT=8025
