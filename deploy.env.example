# Copy to deploy.env (git-ignored) and fill in. Used by `make deploy-prod`.

# SSH target of the production server (user must be in the docker group)
DEPLOY_HOST=cms@203.0.113.10

# Where the project lives on the server (its .env holds production secrets and is never uploaded)
DEPLOY_PATH=/opt/cms

# Optional: SSH key for DEPLOY_HOST (leave empty to use the ssh-agent / ~/.ssh/config)
DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# Optional: URL checked after deploy
DEPLOY_URL=http://203.0.113.10/

# Images are NOT rebuilt on deploy by default. After changing code that goes into an image
# (backend/, frontend/, docker/), deploy with: make deploy-prod build=1
# (images are built on this machine and uploaded to the server, which is too small to build them)
