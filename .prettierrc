{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 80,
    "endOfLine": "lf",
    "semi": false,
    "singleQuote": true,
    "htmlWhitespaceSensitivity": "ignore",
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.css"],
            "options": {
                "singleQuote": false
            }
        }
    ]
}
